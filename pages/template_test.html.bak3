{{ define "layout" }}
<!DOCTYPE html>
<html lang="en" id="page">
<head>
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js" integrity="sha384-/TgkGk7p307TH7EXJDuUlgG3Ce1UVolAOFopFekQkkXihi5u/6OCvVKyz1W+idaz" crossorigin="anonymous"></script>
  <!--<script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->
  <script type="module" src="/static/js/app.js" defer></script>
  <link href="/static/css/output.css" rel="stylesheet">
    <meta charset="UTF-8">
    <title>{{ .Title }}</title>
</head>
<body hx-boost="true" hx-target="#main">
  {{ template "header_bar" . }}
  <div id="main">
    {{ renderTemplate .ContentTemplate . }}
  </div>
</body>
</html>
{{ end }}

<!-- Generic Elements -->

{{ define "error_section" }}
  <div id="error-section">
  {{ range .Errors }}<p style="color: red">{{ . }}</p>{{ end }}
  </div>
{{ end }}

<!-- Add Exercise Page -->

{{ define "addexercise_page" }}
  <div id="addexercise_div">
    <h1 class="font-bold underline">Add A Exercise Page</h1>

    {{ template "add_exercise_form" . }}
    {{ if .Exercises }}
      {{ template "add_exercise_list" . }}
    {{ else }}
      <p>No exercises found</p>
    {{ end }}
  </div>
{{ end }}

<!--

      {
        "detailNames": [
          {{- range $i, $m := .Muscles -}}
            {{- if $i }},{{ end -}}
            {{ $m | js }}
          {{- end -}}
        ]
      }
-->

{{ define "add_exercise_form" }} 
  <div id="add_exercise_form_div" class="container">
    <div id="add_exercise_form_data_feature"  data-feature="add-exercise">
      <script type="application/json" id="addexercise-data">
        {
        "detailNames": {{ .MusclesJson }}
        }
      </script>
      <h2>Exercise Form</h2>
      <form id="addexercise-form" hx-post="/htmx/exercises" hx-target="#add_exercise_form_div" method="POST">
        <!-- Exercise Name -->
        <div class="form-group">
            <label for="addexercise-exercisename">Exercise Name</label>
            <input class="border" type="text" id="addexercise-exercisename" name="exerciseName" required placeholder="Enter exercise name">
        </div>
        <!-- Dynamic Inputs for Exercise Details (Dropdown Name and Value) -->
        <div id="addexercise-detail-collection" class="form-group">
            <label>Exercise Details</label>
            <!-- The first exercise detail will be added dynamically by JavaScript -->
        </div>
        <!-- Add Button -->
        <button type="button" id="addexercise-add-input-button" class="add-btn">+ Add Detail</button>
        <br><br>
        <button type="submit" class="add-btn">Submit</button>
      </form>
    </div>
  </div>
{{ end }}

{{ define "add_exercise_list" }}
  <div id="exercise-list" hx-swap-oob="true">
  <h2>Current Exercises</h2>
  {{range .Exercises}}
    {{ template "exercise" . }}
  {{ end }}
  </div>
{{ end }}

{{ define "exercise" }}
  <div class="exercise-list-item">
    <p>{{ .Name }}</p>
    <ul>
      {{ range .MuscleFractions }}
        <li>{{ .Name }}: {{ .Fraction }}</li>
      {{ end }}
    </ul>
  </div>
{{ end }}

<!-- Error -->

{{ define "error_page" }}
    <script type="text/javascript">
      var canvas = document.createElement('canvas');
      var height = canvas.height = window.innerHeight;
      var width = canvas.width = window.innerWidth;
      var ctx = canvas.getContext('2d');
      document.body.appendChild(canvas);

      function random(min,max)
      {
          return Math.random()*(max-min+1)+min;
      }

      function range_map(value,in_min, in_max, out_min, out_max) {
        return (value - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
      }

      var word_arr = [];
      var txt_min_size = 5;
      var txt_max_size = 25;
      var keypress = false;
      var acclerate = 2;
      for (var i = 0; i < 25; i++) {
        word_arr.push({
          x : random(0,width),
          y : random(0,height),
          text : '404',
          size : random(txt_min_size,txt_max_size)
        });

        word_arr.push({
          x : random(0,width),
          y : random(0,height),
          text : 'page',
          size : random(txt_min_size,txt_max_size)
        });


        word_arr.push({
          x : random(0,width),
          y : random(0,height),
          text : 'not found',
          size : random(txt_min_size,txt_max_size)
        });

        word_arr.push({
          x : random(0,width),
          y : random(0,height),
          text : '404',
          size : Math.floor(random(txt_min_size,txt_max_size))
        });
      }

      function render()
      {
        ctx.fillStyle = "rgba(0,0,0,1)";
        ctx.fillRect(0,0,width,height);

        ctx.fillStyle = "#fff";
        for (var i = 0; i < word_arr.length; i++) {
          ctx.font = word_arr[i].size+"px sans-serif";
          var w = ctx.measureText(word_arr[i].text);
          ctx.fillText(word_arr[i].text,word_arr[i].x,word_arr[i].y);

          if(keypress)
          {
            word_arr[i].x += range_map(word_arr[i].size,txt_min_size,txt_max_size,2,4) * acclerate;
          }
          else {
            word_arr[i].x += range_map(word_arr[i].size,txt_min_size,txt_max_size,2,3);
          }

          if(word_arr[i].x >= width)
          {
            word_arr[i].x = -w.width*2;
            word_arr[i].y = random(0,height);
            word_arr[i].size =  Math.floor(random(txt_min_size,txt_max_size));

          }
        }

        ctx.fill();

        requestAnimationFrame(render);
      }

      render();

      window.addEventListener('keydown',function(){
        keypress = true;
      },true);
      window.addEventListener('keyup',function(){
        keypress = false;
      },true);
    </script>
{{ end }}


{{ define "header_bar" }}
  <div id="header-bar">
    <a href="/addworkout">Workout</a>
    <a href="/addexercise">Exercise</a>
    <a href="/graph">Graph</a>
    <a href="/workoutsummary">Workout Summary</a>
    <a href="/workoutplans">Workout Plans</a>
  </div>
{{ end }}

{{ define "addworkout_page" }}
  <div id="addworkout_div">
    {{ template "add_workout_form" . }} 
  </div>
{{ end }}


{{ define "add_workout_form" }}
  <div id="add_workout_form_div" class="container">
    <h2>Add Workout Page</h2>
    <select hx-trigger="change" hx-target="#add_workout_form_div" hx-swap="outerHTML" hx-get="/htmx/addworkout/selecttype" name="type" id="add-workout-type-select">
      <option value="WorkoutPlan" {{ if eq .WorkoutInstanceType "PlanWorkout"}}selected="selected"{{ end }}>Planned Workout</option>
      <option value="Custom" {{ if eq .WorkoutInstanceType "Custom"}}selected="selected"{{ end }}>Custom Workout</option>
    </select>
  {{ if eq .WorkoutInstanceType "Custom" }}
    {{ template "add_workout_form_custom" . }}
  {{ else if eq .WorkoutInstanceType "WorkoutPlan" }}
    {{ template "add_workout_planned" . }}
  {{ end }}
  </div>
{{ end }}

{{ define "add_workout_planned" }}
    <h3>Planned Workout</h3>
    <select hx-trigger="change" hx-target="#add_workout_planned_form" hx-swap="outerHTML" hx-get="/htmx/addworkout/selectplan" name="plan" id="add-workout-plan-select" hx-include="#add-workout-type-select">
    {{ range .WorkoutPlans }}
      <option value="{{ .Name }}">{{ .Name }}</option>
    {{ end }}
    </select>
    {{ template "add_workout_planned_form" . }}    
{{ end }}

{{ define "add_workout_planned_form"}}
<div id="add_workout_planned_form">
      <div id="add_workout_form_data_feature" data-feature="add-workout-planned">
        <h2>Workout Form</h2>
        <form id="workoutForm" hx-post="/htmx/workouts" hx-target="#add_workout_form_div" hx-swap="outerHTML" method="POST" hx-include="#add-workout-type-select, #add-workout-plan-select">
            <!-- Dynamic Inputs for Exercise Details (Dropdown Name and Value) -->
            <div id="workoutDetails" class="form-group">
                <br />
                <label for="addworkout-start-time">Workout Start Time</label>
                <input type="datetime-local" min="2026-01-01T00:00" value="2026-01-01T00:00" name="workout-start-time" id="addworkout-start-time"/> 
                <br />
                <label for="addworkout-end-time">Workout End Time</label>
                <input type="datetime-local" min="2026-01-01T00:00" value="2026-01-01T00:00" name="workout-end-time" id="addworkout-end-time"/> 
                <br />
                <br />
                <h3>Exercises</h3>
                <div id="addworkout-detail-collection">
                  {{ range (index .WorkoutPlans 0).Sets }}
                  <b>{{ .ExerciseName}}</b>
                  <div>
                    <input type="hidden" name="exerciseName" id="exerciseName" value="{{ .ExerciseName }}" />
                    <label for="startTime">Start Time</label>
                    <input type="time" value="00:00" name="startTime" id="startTime" required/>
                    <label for="weightAmount">Weight</label>
                    <input name="weightAmount" id="weightAmount" type="number" value="1" min="1" max="999" step="0.5" required />
                    <label for="repAmount">Reps ({{ .RepLowerRange }} - {{ .RepUpperRange }})</label>
                    <input name="repAmount" id="repAmount" type="number" value="{{ .RepLowerRange }}" min="1" max="999" step="1" required />
                    <label for="partialRepAmount" >Partial Reps</label>
                    <input id="partialRepAmount" name="partialRepAmount" type="number" value="0" min="0" max="999" step="1" />
                  </div>
                {{ end }}
                </div>
                <!-- The first exercise detail will be added dynamically by JavaScript -->
            </div>
            <!-- Add Button -->
            <button type="button" id="addworkout-add-input-button" class="add-btn">+ Add Set</button>
            <br><br>
            <button type="submit" class="add-btn">Submit</button>
        </form>
      </div>
    </div>
{{ end }}

{{ define "add_workout_form_custom" }}
<h3>Custom Workout</h3>
<div id="add_workout_form_data_feature" data-feature="add-workout-custom">
      <script type="application/json" id="addworkout-data">
        {
          "detailNames": {{.ExercisesJson}}
        }
      </script>
      <h2>Workout Form</h2>
      <form id="workoutForm" hx-post="/htmx/workouts" hx-target="#add_workout_form_div" hx-swap="outerHTML" method="POST" hx-include="#add-workout-type-select, #add-workout-plan-select">
          <!-- Dynamic Inputs for Exercise Details (Dropdown Name and Value) -->
          <div id="workoutDetails" class="form-group">
              <br />
              <label for="addworkout-start-time">Workout Start Time</label>
              <input type="datetime-local" min="2026-01-01T00:00" value="2026-01-01T00:00" name="workout-start-time" id="addworkout-start-time"/> 
              <br />
              <label for="addworkout-end-time">Workout End Time</label>
              <input type="datetime-local" min="2026-01-01T00:00" value="2026-01-01T00:00" name="workout-end-time" id="addworkout-end-time"/> 
              <br />
              <br />
              <h3>Exercises</h3>
              <div id="addworkout-detail-collection">
                
              </div>
              <!-- The first exercise detail will be added dynamically by JavaScript -->
          </div>
          <!-- Add Button -->
          <button type="button" id="addworkout-add-input-button" class="add-btn">+ Add Set</button>
          <br><br>
          <button type="submit" class="add-btn">Submit</button>
      </form>
    </div>
{{ end }}

{{ define "graph_page" }}
  <div id="graph_page_div" >
    {{ template "graph_dataset" . }}
    {{ template "graph_chart" .}}
  </div>
{{ end }}
