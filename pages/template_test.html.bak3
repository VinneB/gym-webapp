{{ define "graph_dataset" }}
  <div id="graph_dataset_list">
    <h3>DataSets</h3>
    {{ template "graph_dataset_info" .}}
    <form id="add_new_dataset" hx-get="/htmx/graphs" hx-target="#graph_chart_div" hx-swap="outerHTML">
      <select name="graph-dataset-calctype-select" hx-get="/htmx/graph_calctype_option" hx-trigger="change" hx-target="#graph-dataset-calctype-option-select" hx-swap="outerHTML">
        {{ range .CalcTypes }}
        <option>{{ . }}</option>
        {{ end }}
      </select>
      {{ template "graph_dataset_calctype_option" .GraphDatasetOptions }}
      <button type="submit">Submit</button>
    </form>
  </div>
{{ end }}

{{ define "graph_dataset_calctype_option" }}
    <select name="graph-dataset-calctype-option-select" id="graph-dataset-calctype-option-select">
      {{ range . }}
        <option value="{{.}}">{{.}}</option>
      {{ end }}
    </select>
{{ end }}

{{ define "graph_dataset_info" }}
  <div id="graph-dataset-info" hx-swap-oob="true">
    {{ range .ChartDataSets }}
    <div id="dataset_list_item">
      <p>
      {{.CalcType}}: {{ .Label }}
      <!-- <button type="button" hx-delete="/htmx/graphs" hx-include="#graph_dataset_list_div div:not(#dataset_list_item_{{.CalcType}}_{{.Label}})">Remove</button> -->
      </p>
      <input type="hidden" name="CalcType" value="{{.CalcType}}">
      <input type="hidden" name="Label" value="{{.Label}}">
    </div>
    {{ end }}
  </div>
{{ end }}

{{ define "graph_chart" }}
  <div id="graph_chart_div" >
    <div id="graph-chart-data-feature" data-feature="graph-chart">
      <script type="application/json" id="graph-chart-json-data">
          {{ .ChartDataSetsJson }}  
      </script>
      <div class="graph-chart-canvas-container">
        <canvas id="graph-chart-canvas"></canvas>
      </div>
    </div>
  </div>
{{ end }}

