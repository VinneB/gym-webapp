{{ define "workoutsummary_page" }}
  <div id="workoutsummary-page-div">
    {{ range .WorkoutSummary }}           
      <div id="workoutsummary-item">
        <h3>Start Time: {{ .StartTime }}  Duration: {{ .Duration }}</h3>
        <h4>Sets</h4>
        {{ range .Sets }}
          <p><b>{{ .ExerciseName }}:</b> Reps = {{ .Reps }} ; Partial Reps = {{ .PartialReps }} Weight = {{ .Weight }}</p>
        {{ end }}
        <h4>Exercise Volume</h4>
        {{ range .ExerciseVolume }}
          <p><b>{{ .Label }}:</b> Volume = {{ .Data }}</p>
        {{ end }}
        <h4>Muscle Volume</h4>
        {{ range .MuscleVolume }}
          <p><b>{{ .Label }}:</b> Volume = {{ .Data }}</p>
        {{ end }}
      </div>
    {{ end }}
  </div>
{{ end }}

{{ define "workoutplans_page" }}
 <div id="workoutplans-page-div">
    <h2>Add new Workout Plan</h2>
      <div id="workoutplans-new">
        <div id="workoutplans-new-data-feature" data-feature="add-workoutplan">
          <script type="application/json" id="add-workoutplan-data">
            {
              "detailNames": {{.ExercisesJson}}
            }
          </script>
          <h2>Workout Form</h2>
          <form id="workoutplan-new-form" hx-post="/htmx/workoutplans" hx-target="#workoutplans-new" hx-swap="outerHTML" method="POST">
            <!-- Dynamic Inputs for Exercise Details (Dropdown Name and Value) -->
            <label for="workoutplan-new-name">Plan Name</label>
            <input type="text" name="workoutplan-new-name" placeholder="Enter Name Here">
            <br />
            <h3>Sets</h3>
            <div id="workoutplans-new-form-set-collection">

            </div>  
                <!-- The first exercise detail will be added dynamically by JavaScript -->
            <!-- Add Button -->
            <button type="button" id="workoutplans-new-form-input-button" class="add-btn">+ Add Set</button>
            <br><br>
            <button type="submit" class="add-btn">Submit</button>
          </form>
        </div> 
      </div> 
    <h2>WorkoutPlans</h2> 
      <div id="workoutplan-list">
        {{ if .WorkoutPlans }}
          {{ range .WorkoutPlans }}
            <h3>{{ .Name }}</h3>
            {{ range .SetCollections }}
              {{ if eq .Format  "ConstantRepsAndConstantSets" }}
              <p>Do <b>{{ .ExerciseName }}</b> for <b>{{(index .RepRange 0).Lower}} - {{(index .RepRange 0).Upper}}</b> reps with <b>{{index .RIRs 0}}</b> RIR for <b>{{ .NumberOfSets }}</b> sets</p>
              {{ else if eq .Format "ConstantReps" }}
              <p>Do <b>{{ .ExerciseName }}</b> for <b>{{(index .RepRange 0).Lower}} - {{(index .RepRange 0).Upper}}</b> reps with {{ range $i, $e := .RIRs }}{{ if $i }}, {{ end }}<b>{{ $e }}</b>{{ end }} RIR</p>
              {{ else if eq .Format  "ConstantWeight" }}
              <p>Do <b>{{ .ExerciseName }}</b> for {{ range $i, $e := .RepRange }}{{ if $i}}, {{end}}<b>{{ $e.Lower }} - {{ $e.Upper }}</b>{{ end }} with <b>{{ index .RIRs 0 }}</b> RIR</p>
              {{ else if eq .Format  "NeitherConstant" }}
              <p>Do <b>{{ .ExerciseName }}</b> for {{ range $i, $e := .RepRange }}{{if $i}}, {{ end }}<b>{{ $e.Lower }} - {{ $e.Upper }}</b>{{ end }} with {{range $i, $e := .RIRs }}{{if $i}}, {{ end }}<b>{{ $e }}</b>{{ end }} RIR</p>
              {{ end }}
            {{ end }}
          {{ end }}
        {{ else }}
          <p>No workout plans</p>
        {{ end }}
      </div>
  </div>
{{ end }}
